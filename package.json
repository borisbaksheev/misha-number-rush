{
  "name": "misha-number-rush",
  "private": true,
  "version": "0.1.0",
  "description": "Misha's Number Rush - a 3D mathematical racing game for kids (offline PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "font": "node scripts/build-font.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "opentype.js": "^1.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
